# Árvore /proc falsa "multi": vários processos com o mesmo nome (pra ordem do pidof e do pgrep -n/-o),
# script rodando por shell (pidof -x), argv[0] reescrito com espaço (sshd, nginx), comm diferente do
# argv[0] (python), nome maior que 15 caracteres, estado D, zumbi, threads de kernel, usuários com
# nome longo e uid sem nome, e uma árvore de vários níveis pro --forest. Boot em 1768477400 e agora
# 200000 s depois (2026-01-17T19:16:40Z): quase todos começaram há mais de 24 h, dois há poucas horas.
# Formato descrito em basic.fixture.

@clock 1768677400 200000

@file /etc/passwd
root:x:0:0:root:/root:/bin/bash
daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin
www-data:x:33:33:www-data:/var/www:/usr/sbin/nologin
alice:x:1000:1000:Alice:/home/alice:/bin/bash
verylongusername:x:1001:100::/home/v:/bin/bash
nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin
@file /etc/group
root:x:0:
daemon:x:1:
www-data:x:33:
users:x:100:
alice:x:1000:
nogroup:x:65534:

# O pidof com caminho só procura se o arquivo existe; no Debian onde o esperado foi gravado existe
# (/bin é link pra usr/bin).
@file /usr/bin/bash
#!ELF

@link /proc/self 101
@link /proc/thread-self 101/task/101
@file /proc/sys/kernel/pid_max
4194304
