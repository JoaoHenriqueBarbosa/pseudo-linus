/target/
/testbench/target/
/testbench/experiments/*/target/
/wip/*/target/
# Cópia de trabalho do zjsc onde o integrador compila (rsync de wip/zjsc) com o alvo de build ao lado.
/target-zjsc-snap/
/testbench/corpus/agent/
/testbench/corpus/upstream/
# O scratch é versionado (trabalho que só existia nele se perdeu quando uma worktree foi limpa);
# fica de fora só o que é gerado ou baixado e pesa: alvos de build, binários e caches de experimento,
# e as fontes de terceiros que se baixam de novo.
/testbench/scratch/**/target/
/testbench/scratch/**/*.tar.gz
/testbench/scratch/**/*.tar.xz
/testbench/scratch/**/*.tgz
/testbench/scratch/agents/*/*-[0-9]*/
/testbench/scratch/f01-regex/mined-golden-*.json
/testbench/scratch/f04-awk-jq/tools/
/testbench/scratch/f06-coreutils-find/uu-bin/
/testbench/scratch/zstd-1.5.7/
/testbench/scratch/zlibsrc/
/testbench/scratch/gzsrc/
/testbench/scratch/infozip/
/testbench/scratch/gtar/
