        "data": "def parse(value):\n    if value is None:\n        return None\n    value = value.strip()\n    if not value:\n        return None\n    if value.startswith(\"0x\"):\n        return int(value, 16)\n    return int(value)\n\n\ndef render(value):\n    if value is None:\n        return \"\"\n    return f\"{value}\"\n"
