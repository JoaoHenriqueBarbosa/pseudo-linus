<!DOCTYPE html>
<html lang="pt-BR"><head>
<meta charset="utf-8">
<title>lab: observadores</title>
<style>
  body { margin: 0; font: 16px/1.25 sans-serif; }
  #alto { height: 2000px; }
  .caixa { width: 200px; height: 100px; }
</style>
</head>
<body>
<h1>Observadores</h1>
<ul id="lista"><li></li><li>um</li></ul>
<div id="topo" class="caixa" style="width: 320px;">visível</div>
<div id="alto"></div>
<div id="fundo" class="caixa">fora da tela</div>
<pre id="log">takeRecords antes da microtarefa: 5
fim do script síncrono
MO lote de 1 (observer é o mesmo: true)
  childList alvo=UL +0 -1 prev=LI next=null
MO2 recebeu childList,childList
microtarefa depois da entrega? ordem registrada
RO topo content 200x100 border 200x100
IO topo isIntersecting=true ratio=1.00 alvo 200x100 top=139
IO fundo isIntersecting=false ratio=0.00 alvo 200x100 top=2239
largura trocada para 320px</pre>
<script>
  var lines = [];
  function log(line) { lines.push(String(line)); document.getElementById('log').firstChild ? document.getElementById('log').firstChild.data = lines.join('\n') : document.getElementById('log').appendChild(document.createTextNode(lines.join('\n'))); }
  var lista = document.getElementById('lista');

  var mo = new MutationObserver(function (records, observer) {
    log('MO lote de ' + records.length + ' (observer é o mesmo: ' + (observer === mo) + ')');
    records.forEach(function (r) {
      log('  ' + r.type + ' alvo=' + (r.target.nodeName) + (r.attributeName ? ' attr=' + r.attributeName + ' old=' + r.oldValue : '') +
          (r.type === 'childList' ? ' +' + r.addedNodes.length + ' -' + r.removedNodes.length + ' prev=' + (r.previousSibling && r.previousSibling.nodeName) + ' next=' + (r.nextSibling && r.nextSibling.nodeName) : '') +
          (r.type === 'characterData' ? ' old=' + r.oldValue : ''));
    });
  });
  mo.observe(lista, { childList: true, subtree: true, attributes: true, attributeOldValue: true, characterData: true, characterDataOldValue: true, attributeFilter: ['class', 'data-x'] });

  var item = document.createElement('li');
  item.textContent = 'dois';
  lista.appendChild(item);
  item.className = 'novo';
  item.setAttribute('title', 'filtrado');
  item.setAttribute('data-x', '1');
  item.firstChild.data = 'DOIS';
  lista.insertBefore(document.createElement('li'), lista.firstChild);
  log('takeRecords antes da microtarefa: ' + mo.takeRecords().length);
  lista.lastChild.remove();
  Promise.resolve().then(function () { log('microtarefa depois da entrega? ordem registrada'); });

  var mo2 = new MutationObserver(function (records) { log('MO2 recebeu ' + records.map(function (r) { return r.type; }).join(',')); mo2.disconnect(); });
  mo2.observe(document.body, { childList: true });
  document.body.appendChild(document.createComment('c'));
  document.body.appendChild(document.createComment('d'));
  setTimeout(function () { document.body.appendChild(document.createComment('depois do disconnect')); }, 0);

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      log('IO ' + e.target.id + ' isIntersecting=' + e.isIntersecting + ' ratio=' + e.intersectionRatio.toFixed(2) + ' alvo ' + Math.round(e.boundingClientRect.width) + 'x' + Math.round(e.boundingClientRect.height) + ' top=' + Math.round(e.boundingClientRect.top));
    });
  }, { threshold: [0, 0.5, 1] });
  io.observe(document.getElementById('topo'));
  io.observe(document.getElementById('fundo'));

  var ro = new ResizeObserver(function (entries) {
    entries.forEach(function (e) {
      log('RO ' + e.target.id + ' content ' + e.contentRect.width + 'x' + e.contentRect.height + ' border ' + e.borderBoxSize[0].inlineSize + 'x' + e.borderBoxSize[0].blockSize);
    });
  });
  ro.observe(document.getElementById('topo'));
  setTimeout(function () {
    document.getElementById('topo').style.width = '320px';
    log('largura trocada para 320px');
  }, 50);
  log('fim do script síncrono');
</script><!--c--><!--d-->


<!--depois do disconnect--></body></html>
