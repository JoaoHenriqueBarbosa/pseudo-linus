					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha25" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Short description&quot;,&quot;href&quot;:&quot;./Template:Short_description&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Free general-purpose operating system&quot;}},&quot;i&quot;:0}}]}">Free general-purpose operating system</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"></span>
<p class="mw-empty-elt" id="mwAw"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt2" id="mwBA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Good article&quot;,&quot;href&quot;:&quot;./Template:Good_article&quot;},&quot;params&quot;:{},&quot;i&quot;:0}}]}"></span><meta typeof="mw:Extension/indicator" about="#mwt2" id="mwBQ" data-mw="{&quot;name&quot;:&quot;indicator&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;good-star&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;[[File:symbol support vote.svg|20x20px |link=Wikipedia:Good articles*   |This is a good article. Click here for more information.]]\n&quot;}}"><link rel="mw:PageProp/Category" href="./Category:Good_articles" about="#mwt2" id="mwBg"></p>

<p class="mw-empty-elt" id="mwBw"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt4" id="mwCA" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Use mdy dates&quot;,&quot;href&quot;:&quot;./Template:Use_mdy_dates&quot;},&quot;params&quot;:{&quot;date&quot;:{&quot;wt&quot;:&quot;May 2026&quot;}},&quot;i&quot;:0}}]}"></span><link rel="mw:PageProp/Category" href="./Category:Use_mdy_dates_from_May_2026" about="#mwt4" id="mwCQ"></p>

<div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt5" typeof="mw:Transclusion" id="mwCg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Infobox OS\n&quot;,&quot;href&quot;:&quot;./Template:Infobox_OS&quot;},&quot;params&quot;:{&quot;name&quot;:{&quot;wt&quot;:&quot;Debian&quot;},&quot;logo&quot;:{&quot;wt&quot;:&quot;Openlogo-debianV2.svg&quot;},&quot;logo size&quot;:{&quot;wt&quot;:&quot;90px&quot;},&quot;logo caption&quot;:{&quot;wt&quot;:&quot;Debian Open Use Logo &lt;!-- This caption is to remove ambiguity; the project has two logos, the \&quot;restricted\&quot; and the \&quot;open\&quot; --&gt;&quot;},&quot;logo alt&quot;:{&quot;wt&quot;:&quot;A red swirl&quot;},&quot;screenshot&quot;:{&quot;wt&quot;:&quot;Debian 13 (Trixie) screenshot - using GNOME desktop.png&quot;},&quot;screenshot_size&quot;:{&quot;wt&quot;:&quot;284px &lt;!-- Maintain a size that does not expand the default infobox width --&gt;&quot;},&quot;caption&quot;:{&quot;wt&quot;:&quot;Debian 13 \&quot;Trixie\&quot; running &lt;span class=\&quot;plainlinks\&quot;&gt;[[GNOME#GNOME 40 and higher|GNOME 48]]&lt;/span&gt;&quot;},&quot;screenshot_alt&quot;:{&quot;wt&quot;:&quot;A desktop interface showing the Debian \&quot;Trixie\&quot; wallpaper \&quot;Ceratopsian\&quot;, a dark top bar with a centered clock, and an application dock at the bottom. Two windows are open: a Firefox ESR web browser displaying the Debian home page, and a GNOME Console window running neofetch to display system information&quot;},&quot;collapsible&quot;:{&quot;wt&quot;:&quot;yes&quot;},&quot;developer&quot;:{&quot;wt&quot;:&quot;Debian Project&quot;},&quot;family&quot;:{&quot;wt&quot;:&quot;[[Unix-like]] &lt;!-- \&quot;Do not add 'Linux', as the project also maintains the GNU/Hurd and once maintained the GNU/kFreeBSD project, both of which are not Linux but are still Unix-like --&gt;&quot;},&quot;working state&quot;:{&quot;wt&quot;:&quot;Current&quot;},&quot;source model&quot;:{&quot;wt&quot;:&quot;[[Free software|Free]]&quot;},&quot;released&quot;:{&quot;wt&quot;:&quot;{{Start date and age|1993|08|16|df=yes}}&quot;},&quot;latest release version&quot;:{&quot;wt&quot;:&quot;{{wikidata|property|preferred|Q7715973|P1476|P548=Q2804309}}{{wikidata|property|preferred|references|edit|Q7715973|P348|P548=Q2804309}} \&quot;Trixie\&quot;&quot;},&quot;latest release date&quot;:{&quot;wt&quot;:&quot;{{Start date and age|{{wikidata|qualifier|preferred|single|Q7715973|P348|P548=Q2804309|P577}}|df=yes}}&quot;},&quot;latest preview version&quot;:{&quot;wt&quot;:&quot;14 \&quot;Forky\&quot;&lt;ref&gt;{{cite web|last=Evenden|first=Ian|date=2022-10-13|title=Debian 14 To Be Named 'Forky', Won't Arrive Until 2027|url=https://www.tomshardware.com/news/debian-14-forky#:~:text=Debian%2014%20will,the%20Disney%20series.|website=Tom's Hardware|access-date=2026-05-19}}&lt;/ref&gt;&quot;},&quot;repo&quot;:{&quot;wt&quot;:&quot;{{URL|https://deb.debian.org/}}&quot;},&quot;marketing target&quot;:{&quot;wt&quot;:&quot;General-purpose&quot;},&quot;language&quot;:{&quot;wt&quot;:&quot;&lt;!-- Include only fully supported languages --&gt; Languages available in [[Debian-Installer]]: Amharic, Arabic, Asturian, Belarusian, Bulgarian, Bengali, Tibetan, Bosnian, Catalan, Czech, Welsh, Danish, German, Dzongkha, Greek, English, Esperanto, Spanish, Estonian, Basque, Persian, Finnish, French, Irish, Galician, Gujarati, Hebrew, Croatian, Hungarian, Indonesian, Icelandic, Italian, Japanese, Georgian, Kabyle, Kazakh, Khmer, Kannada, Korean, Kurdish, Lao, Lithuanian, Latvian, Malagasy, Macedonian, Malayalam, Marathi, Burmese, Norwegian Bokmal, Norwegian Nynorsk, Nepali, Dutch, Occitan, Punjabi (Gurmukhi), Polish, Portuguese, Portuguese (Brazil), Romanian, Russian, Northern Sami, Sinhala, Slovak, Slovenian, Albanian, Serbian, Swedish, Tamil, Telugu, Tajik, Thai, Tagalog, Turkish, Uyghur, Ukrainian, Vietnamese, Chinese (Simplified), and Chinese (Traditional)&lt;ref&gt;{{cite web|title=Debian-Installer languages support, statistics and translators|url=https://d-i.debian.org/doc/languages.html|website=Debian-Installer|access-date=2026-05-19}}&lt;/ref&gt;&quot;},&quot;language count&quot;:{&quot;wt&quot;:&quot;77&lt;!-- The number 78 is wrong, due to the page referencing Norwegian Nynorsk twice --&gt;&quot;},&quot;language footnote&quot;:{&quot;wt&quot;:&quot;&lt;ref&gt;{{cite web|date=2025-08-09|title=Debian 13 \&quot;trixie\&quot; released|url=https://www.debian.org/News/2025/20250809#:~:text=Debian%20can%20now,%20graphical%20user%20interfaces.|website=Debian|access-date=2026-05-19|quote=The number 78 is wrong, because the page that lists the translations references Norwegian Nynorsk twice.}}&lt;/ref&gt;&quot;},&quot;update model&quot;:{&quot;wt&quot;:&quot;[[APT (software)|APT]]&quot;},&quot;package manager&quot;:{&quot;wt&quot;:&quot;[[dpkg]]&quot;},&quot;instruction sets&quot;:{&quot;wt&quot;:&quot;{{Unbulleted list\n|'''[[Linux kernel|Linux]]:''' [[amd64]], [[arm64]], armel, [[armhf]], [[ppc64el]], [[RISC-V|riscv64]], [[s390x]]&lt;ref name=\&quot;trixie-supported-architectures\&quot;&gt;{{cite web|date=2025|title=2. What’s new in Debian 13|url=https://www.debian.org/releases/stable/release-notes/whats-new.html#supported-architectures|website=Debian Release Notes|access-date=2026-05-19}}&lt;/ref&gt;\n|'''[[Hurd]]:''' [[amd64]], [[i386]]&lt;ref&gt;{{cite web|date=2025-08-10|title=News about Debian GNU/Hurd|url=https://www.debian.org/ports/hurd/hurd-news|website=Debian|access-date=2026-09-25}}&lt;/ref&gt;\n}}&quot;},&quot;kernel type&quot;:{&quot;wt&quot;:&quot;[[Monolithic kernel|Monolithic]] (Linux)&lt;br /&gt;[[Microkernel|Micro]] (Hurd)&quot;},&quot;userland&quot;:{&quot;wt&quot;:&quot;[[GNU Core Utilities]]&quot;},&quot;ui&quot;:{&quot;wt&quot;:&quot;[[GNOME]]&lt;ref&gt;{{cite web|title=Details of package task-desktop in trixie |url=https://packages.debian.org/trixie/task-desktop|website=Debian Packages|access-date=2026-05-19|quote=Metapackage used by tasksel in Debian-Installer to pull a desktop environment}}&lt;/ref&gt;&quot;},&quot;license&quot;:{&quot;wt&quot;:&quot;[[free software license|Free licenses]] compliant with [[The Open Source Definition#Debian Free Software Guidelines|DFSG]]&quot;},&quot;website&quot;:{&quot;wt&quot;:&quot;{{URL|https://www.debian.org/|debian.org}}&quot;},&quot;tagline&quot;:{&quot;wt&quot;:&quot;The Universal Operating System&quot;}},&quot;i&quot;:0}}]}">Operating system</div><span class="mw-empty-elt" about="#mwt5"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Module:Infobox/styles.css&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}">@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!impo