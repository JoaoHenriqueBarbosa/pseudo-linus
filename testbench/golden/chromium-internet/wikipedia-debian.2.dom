ian.org/vote/2022/vote_001_quorum.log 2022] &quot;},&quot;48&quot;:{&quot;wt&quot;:&quot;1023\n&quot;},&quot;49&quot;:{&quot;wt&quot;:&quot;[//www.debian.org/vote/2023/vote_001_quorum.log 2023] &quot;},&quot;50&quot;:{&quot;wt&quot;:&quot;996\n&quot;},&quot;51&quot;:{&quot;wt&quot;:&quot;[//www.debian.org/vote/2024/vote_001_quorum.log 2024] &quot;},&quot;52&quot;:{&quot;wt&quot;:&quot;1010\n&quot;},&quot;53&quot;:{&quot;wt&quot;:&quot;[//www.debian.org/vote/2025/vote_001_quorum.log 2025] &quot;},&quot;54&quot;:{&quot;wt&quot;:&quot;1030\n&quot;},&quot;55&quot;:{&quot;wt&quot;:&quot;[//www.debian.org/vote/2026/vote_001_quorum.log 2026] &quot;},&quot;56&quot;:{&quot;wt&quot;:&quot;1039&quot;}},&quot;i&quot;:0}}]}"><style data-mw-deduplicate="TemplateStyles:r1376789456" typeof="mw:Extension/templatestyles" about="#mwt645" data-mw="{&quot;name&quot;:&quot;templatestyles&quot;,&quot;attrs&quot;:{&quot;src&quot;:&quot;Module:Historical populations/styles.css&quot;}}">.mw-parser-output .abbr-header{white-space:nowrap}.mw-parser-output .caption-purple{border:1px var(--border-color-base,#a2a9b1)solid;border-bottom:none;background-color:lavender}@media screen{html.skin-theme-clientpref-night .mw-parser-output .caption-purple{background-color:inherit!important}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .caption-purple{background-color:inherit!important}}.mw-parser-output .table-pale{border:1px var(--border-color-base,#a2a9b1)solid;border-top:none;background-color:var(--background-color-neutral-subtle,#f8f9fa);padding:5px}@media screen and (max-width:640px){.mw-parser-output .table-pale{border-top:1px var(--border-color-base,#a2a9b1)solid!important;float:none!important;margin:auto!important}.mw-parser-output .caption-purple{border:none;display:block}}</style></span><table class="table-pale" style="width:15em;border-top-width:0;border-spacing: 0;float:right;clear:right;margin:0.5em 0 1em 0.5em;" about="#mwt644" id="mwBXw"><caption class="caption-purple" style="padding:0.25em;font-weight:bold">Debian developer population</caption><tbody><tr style="font-size:95%"><th style="border-bottom:1px solid var(--color-base, #000000);padding:1px;width:3em">Year</th><th style="border-bottom:1px solid var(--color-base, #000000);padding:1px 2px;text-align:right"><abbr title="Debian developers" about="#mwt646" typeof="mw:ExpandedAttrs" data-mw="{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;&lt;span typeof=\&quot;mw:Nowiki\&quot; id=\&quot;mwBX0\&quot;&gt;Debian developers&lt;/span&gt;&quot;}]]}">DD</abbr></th><th style="border-bottom:1px solid var(--color-base, #000000);padding:1px;text-align:right"><abbr title="Percent change" class="abbr-header">±%</abbr></th></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/1999/vote_0001#quorum" class="external text">1999</a> </th><td style="text-align:right;padding:1px">347</td><td style="text-align:right;padding:1px">—<span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span></td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2000/vote_0007#quorum" class="external text">2000</a> </th><td style="text-align:right;padding:1px">347</td><td style="text-align:right;padding:1px">+0.0%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2001/vote_0001#quorum" class="external text">2001</a> </th><td style="text-align:right;padding:1px">?</td><td style="text-align:right;padding:1px">—<span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span></td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2002/vote_0001#quorum" class="external text">2002</a> </th><td style="text-align:right;padding:1px">939</td><td style="text-align:right;padding:1px">—<span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">&nbsp;</span></td></tr><tr><th style="text-align:center;padding:1px;border-bottom:1px solid #bbbbbb"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2003/vote_0001#quorum" class="external text">2003</a> </th><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">831</td><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">−11.5%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2004/vote_001.quorum.log" class="external text">2004</a> </th><td style="text-align:right;padding:1px">911</td><td style="text-align:right;padding:1px">+9.6%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2005/vote_001.quorum.log" class="external text">2005</a> </th><td style="text-align:right;padding:1px">965</td><td style="text-align:right;padding:1px">+5.9%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2006/vote_001_quorum.log" class="external text">2006</a> </th><td style="text-align:right;padding:1px">972</td><td style="text-align:right;padding:1px">+0.7%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2007/vote_001_quorum.log" class="external text">2007</a> </th><td style="text-align:right;padding:1px">1,036</td><td style="text-align:right;padding:1px">+6.6%</td></tr><tr><th style="text-align:center;padding:1px;border-bottom:1px solid #bbbbbb"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2008/vote_001_quorum.log" class="external text">2008</a> </th><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">1,075</td><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">+3.8%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2009/vote_001_quorum.log" class="external text">2009</a> </th><td style="text-align:right;padding:1px">1,013</td><td style="text-align:right;padding:1px">−5.8%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2010/vote_001_quorum.log" class="external text">2010</a> </th><td style="text-align:right;padding:1px">886</td><td style="text-align:right;padding:1px">−12.5%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2011/vote_001_quorum.log" class="external text">2011</a> </th><td style="text-align:right;padding:1px">911</td><td style="text-align:right;padding:1px">+2.8%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2012/vote_001_quorum.log" class="external text">2012</a> </th><td style="text-align:right;padding:1px">948</td><td style="text-align:right;padding:1px">+4.1%</td></tr><tr><th style="text-align:center;padding:1px;border-bottom:1px solid #bbbbbb"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2013/vote_001_quorum.log" class="external text">2013</a> </th><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">988</td><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">+4.2%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2014/vote_001_quorum.log" class="external text">2014</a> </th><td style="text-align:right;padding:1px">1,003</td><td style="text-align:right;padding:1px">+1.5%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2015/vote_001_quorum.log" class="external text">2015</a> </th><td style="text-align:right;padding:1px">1,033</td><td style="text-align:right;padding:1px">+3.0%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2016/vote_001_quorum.log" class="external text">2016</a> </th><td style="text-align:right;padding:1px">1,023</td><td style="text-align:right;padding:1px">−1.0%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2017/vote_001_quorum.log" class="external text">2017</a> </th><td style="text-align:right;padding:1px">1,062</td><td style="text-align:right;padding:1px">+3.8%</td></tr><tr><th style="text-align:center;padding:1px;border-bottom:1px solid #bbbbbb"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2018/vote_001_quorum.log" class="external text">2018</a> </th><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">1,001</td><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">−5.7%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2019/vote_001_quorum.log" class="external text">2019</a> </th><td style="text-align:right;padding:1px">1,003</td><td style="text-align:right;padding:1px">+0.2%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2020/vote_001_quorum.log" class="external text">2020</a> </th><td style="text-align:right;padding:1px">1,011</td><td style="text-align:right;padding:1px">+0.8%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2021/vote_001_quorum.log" class="external text">2021</a> </th><td style="text-align:right;padding:1px">1,018</td><td style="text-align:right;padding:1px">+0.7%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2022/vote_001_quorum.log" class="external text">2022</a> </th><td style="text-align:right;padding:1px">1,023</td><td style="text-align:right;padding:1px">+0.5%</td></tr><tr><th style="text-align:center;padding:1px;border-bottom:1px solid #bbbbbb"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2023/vote_001_quorum.log" class="external text">2023</a> </th><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">996</td><td style="text-align:right;padding:1px;border-bottom:1px solid #bbbbbb">−2.6%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2024/vote_001_quorum.log" class="external text">2024</a> </th><td style="text-align:right;padding:1px">1,010</td><td style="text-align:right;padding:1px">+1.4%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2025/vote_001_quorum.log" class="external text">2025</a> </th><td style="text-align:right;padding:1px">1,030</td><td style="text-align:right;padding:1px">+2.0%</td></tr><tr><th style="text-align:center;padding:1px"><a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/2026/vote_001_quorum.log" class="external text">2026</a> </th><td style="text-align:right;padding:1px">1,039</td><td style="text-align:right;padding:1px">+0.9%</td></tr><tr><td colspan="3" style="border-top:1px solid var(--color-base, #000000);font-size:85%;text-align:left">Source: <a rel="mw:ExtLink nofollow" href="//www.debian.org/vote/" class="external text">Debian Voting Information</a></td></tr></tbody></table>

<p id="mwBX4">Debian developers are organized in a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Web_of_trust" title="Web of trust" id="mwBX8">web of trust</a>.<sup about="#mwt647" class="mw-ref reference" id="cite_ref-FOOTNOTEColeman_2013143_145-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;name&quot;:&quot;FOOTNOTEColeman 2013143&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-FOOTNOTEColeman_2013143-145&quot;},&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;sfn&quot;,&quot;href&quot;:&quot;./Template:Sfn&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Coleman 2013&quot;},&quot;p&quot;:{&quot;wt&quot;:&quot;143&quot;}},&quot;i&quot;:0}}]}"><a href="#cite_note-FOOTNOTEColeman_2013143-145" id="mwBYA"><span class="mw-reflink-text" id="mwBYE"><span class="cite-bracket" id="mwBYI">[</span>145<span class="cite-bracket" id="mwBYM">]</span></span></a></sup> There are about one thousand active Debian developers,<sup about="#mwt652" class="mw-ref reference" id="cite_ref-146" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-146&quot;}}"><a href="#cite_note-146" id="mwBYQ"><span class="mw-reflink-text" id="mwBYU"><span class="cite-bracket" id="mwBYY">[</span>146<span class="cite-bracket" id="mwBYc">]</span></span></a></sup><sup about="#mwt655" class="mw-ref reference" id="cite_ref-147" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-147&quot;}}"><a href="#cite_note-147" id="mwBYg"><span class="mw-reflink-text" id="mwBYk"><span class="cite-bracket" id="mwBYo">[</span>147<span class="cite-bracket" id="mwBYs">]</span></span></a></sup> but it is possible to contribute to the project without being an official developer.<sup about="#mwt658" class="mw-ref reference" id="cite_ref-148" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-148&quot;}}"><a href="#cite_note-148" id="mwBYw"><span class="mw-reflink-text" id="mwBY0"><span class="cite-bracket" id="mwBY4">[</span>148<span class="cite-bracket" id="mwBY8">]</span></span></a></sup></p>

<p id="mwBZA">The project maintains official <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mailing_list" title="Mailing list" id="mwBZE">mailing lists</a> and conferences for communication and coordination between developers.<sup about="#mwt661" class="mw-ref reference" id="cite_ref-149" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-149&quot;}}"><a href="#cite_note-149" id="mwBZI"><span class="mw-reflink-text" id="mwBZM"><span class="cite-bracket" id="mwBZQ">[</span>149<span class="cite-bracket" id="mwBZU">]</span></span></a></sup> For issues with single packages and other tasks,<sup about="#mwt664" class="mw-ref reference" id="cite_ref-150" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-150&quot;}}"><a href="#cite_note-150" id="mwBZY"><span class="mw-reflink-text" id="mwBZc"><span class="cite-bracket" id="mwBZg">[</span>150<span class="cite-bracket" id="mwBZk">]</span></span></a></sup> a public <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_bug" title="Software bug" id="mwBZo">bug</a> tracking system is used by developers and end users. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Relay_Chat" title="Internet Relay Chat" class="mw-redirect" id="mwBZs">Internet Relay Chat</a> is also used for communication among developers and to provide real time help.<sup about="#mwt667" class="mw-ref reference" id="cite_ref-151" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-151&quot;}}"><a href="#cite_note-151" id="mwBZw"><span class="mw-reflink-text" id="mwBZ0"><span class="cite-bracket" id="mwBZ4">[</span>151<span class="cite-bracket" id="mwBZ8">]</span></span></a></sup></p>

<p id="mwBaA">Debian is supported by donations made to organizations authorized by the leader. The largest supporter is <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_in_the_Public_Interest" title="Software in the Public Interest" id="mwBaE">Software in the Public Interest</a>, the owner of the Debian <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trademark" title="Trademark" id="mwBaI">trademark</a>, manager of the monetary donations<sup about="#mwt670" class="mw-ref reference" id="cite_ref-152" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-152&quot;}}"><a href="#cite_note-152" id="mwBaM"><span class="mw-reflink-text" id="mwBaQ"><span class="cite-bracket" id="mwBaU">[</span>152<span class="cite-bracket" id="mwBaY">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Umbrella_organization" title="Umbrella organization" id="mwBac">umbrella organization</a> for various other community free software projects.<sup about="#mwt671" class="mw-ref reference" id="cite_ref-what-is-debian-project_9-3" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;what-is-debian-project&quot;}}"><a href="#cite_note-what-is-debian-project-9" id="mwBag"><span class="mw-reflink-text" id="mwBak"><span class="cite-bracket" id="mwBao">[</span>9<span class="cite-bracket" id="mwBas">]</span></span></a></sup></p>

<p id="mwBaw">A Project Leader is elected once per year by the developers. The leader has special powers, but they are not absolute, and appoints delegates to perform specialized tasks. Delegates make decisions as they think is best, taking into account technical criteria and consensus. By way of a General Resolution, the developers may recall the leader, reverse a decision made by the leader or a delegate, amend foundation documents and make other binding decisions. The voting method is based on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Schulze_method" title="Schulze method" id="mwBa0">Schulze method</a> (Cloneproof Schwartz Sequential Dropping).<sup about="#mwt674" class="mw-ref reference" id="cite_ref-153" rel="dc:references" typeof="mw:Extension/ref" data-mw="{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-153&quot;}}"><a href="#cite_note-153" id="mwBa4"><span class="mw-reflink-text" id="mwBa8"><span class="cite-bracket" id="mwBbA">[</span>153<span class="cite-bracket" id="mwBbE">]</span></span></a></sup></p>

