[exit=1]
$ git restore -S -W .
[out]
[err]
[exit=0]
$ git restore .
[out]
[err]
[exit=0]
$ git restore --source=nonexist a.txt
[out]
[err]
fatal: could not resolve nonexist
[exit=128]
$ git restore -q a.txt
[out]
[err]
[exit=0]
$ git restore --staged
