== restore
$ git restore a.txt
[out]
[err]
[exit=0]
a
$ git restore a.txt
[out]
[err]
[exit=0]
mod
$ git restore --staged a.txt
[out]
[err]
[exit=0]
 M a.txt
$ git restore --staged --worktree a.txt
[out]
[err]
[exit=0]
$ git restore --source=HEAD~2 --staged --worktree a.txt
[out]
[err]
[exit=0]
$ git restore -s HEAD~1 a.txt
[out]
[err]
[exit=0]
$ git restore --source HEAD~1 nonexist
[out]
[err]
error: pathspec 'nonexist' did not match any file(s) known to git
[exit=1]
