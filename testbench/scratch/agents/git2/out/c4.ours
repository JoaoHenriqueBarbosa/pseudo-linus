== checkout -b with local mods
$ git checkout -b nb
[out]
[err]
Switched to a new branch 'nb'
[exit=0]
$ git checkout --detach HEAD~1
[out]
M	a.txt
[err]
HEAD is now at f742ed7 add b
[exit=0]
== checkout <tree> -- path
$ git checkout old -- b.txt
[out]
[err]
[exit=0]
$ git checkout HEAD~2 -- b.txt c.txt
[out]
[err]
error: pathspec 'b.txt' did not match any file(s) known to git
error: pathspec 'c.txt' did not match any file(s) known to git
[exit=1]
$ git checkout old -- .
[out]
[err]
[exit=0]
$ git checkout old
[out]
[err]
Switched to branch 'old'
[exit=0]
$ git checkout old b.txt
[out]
[err]
Updated 0 paths from f4b3548
[exit=0]
$ git checkout HEAD~1 b.txt
[out]
[err]
error: pathspec 'b.txt' did not match any file(s) known to git
[exit=1]
$ git checkout -q HEAD~1 b.txt
[out]
[err]
error: pathspec 'b.txt' did not match any file(s) known to git
[exit=1]
== path with ambiguity
$ git checkout b.txt
[out]
[err]
Switched to branch 'b.txt'
[exit=0]
$ git checkout -- b.txt
[out]
[err]
[exit=0]
$ git checkout b.txt --
[out]
[err]
