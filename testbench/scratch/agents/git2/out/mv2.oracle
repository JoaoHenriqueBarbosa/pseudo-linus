== source dir exists untracked, dest missing dir parent
$ git mv a.txt nonexist/sub/a.txt
[out]
[err]
fatal: renaming 'a.txt' failed: No such file or directory
[exit=128]
== mv to same file in other form
$ git mv a.txt ./a.txt
[out]
[err]
fatal: can not move directory into itself, source=a.txt, destination=a.txt
[exit=128]
$ git mv a.txt nd/../a.txt
[out]
[err]
fatal: can not move directory into itself, source=a.txt, destination=a.txt
[exit=128]
